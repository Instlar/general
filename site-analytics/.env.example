# Set these as environment variables in your hosting panel, or export before starting.
# Never commit your real secrets.
HOST=127.0.0.1
PORT=4301
DB_PATH=./data/analytics.sqlite
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Set to 1 when behind a trusted HTTPS reverse proxy (sets Secure cookies).
TRUST_PROXY_HTTPS=1
